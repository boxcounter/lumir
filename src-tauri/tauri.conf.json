{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumir",
  "version": "0.4.0",
  "identifier": "com.lumir.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumir",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "本地文本工作台",
    "longDescription": "Lumir 是一个本地优先的 Markdown 文本工作台，带 Emacs 键位与三套主题（light / dark / eink）。所有文件留在你自己的 vault 目录里，不上传、不联网。",
    "copyright": "Copyright © 2026 Alex",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
