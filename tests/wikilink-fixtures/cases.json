{
  "version": 1,
  "spec": "docs/specs/wikilink/link-semantics.md",
  "vaultRoot": "vault",
  "spanUnit": "unicode-code-point",
  "parseCases": [
    { "id": "link-basic", "input": "[[Beta]]", "expect": { "links": [ { "span": [0, 8], "embed": false, "path": "Beta", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-alias", "input": "[[Gamma|伽马笔记]]", "expect": { "links": [ { "span": [0, 14], "embed": false, "path": "Gamma", "headingPath": [], "alias": "伽马笔记", "blockRef": false } ] } },
    { "id": "link-alias-pipe", "input": "[[a|b|c]]", "expect": { "links": [ { "span": [0, 9], "embed": false, "path": "a", "headingPath": [], "alias": "b|c", "blockRef": false } ] } },
    { "id": "link-alias-empty", "input": "[[Beta|]]", "expect": { "links": [ { "span": [0, 9], "embed": false, "path": "Beta", "headingPath": [], "alias": "", "blockRef": false } ] } },
    { "id": "link-heading", "input": "[[Gamma#设计]]", "expect": { "links": [ { "span": [0, 12], "embed": false, "path": "Gamma", "headingPath": ["设计"], "alias": null, "blockRef": false } ] } },
    { "id": "link-heading-nested", "input": "[[Gamma#设计#子点]]", "expect": { "links": [ { "span": [0, 15], "embed": false, "path": "Gamma", "headingPath": ["设计", "子点"], "alias": null, "blockRef": false } ] } },
    { "id": "link-heading-alias", "input": "[[Gamma#设计|别名]]", "expect": { "links": [ { "span": [0, 15], "embed": false, "path": "Gamma", "headingPath": ["设计"], "alias": "别名", "blockRef": false } ] } },
    { "id": "link-heading-trailing-hash", "input": "[[Beta#]]", "expect": { "links": [ { "span": [0, 9], "embed": false, "path": "Beta", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-heading-blank-segment", "input": "[[Gamma#设计#]]", "expect": { "links": [ { "span": [0, 13], "embed": false, "path": "Gamma", "headingPath": ["设计"], "alias": null, "blockRef": false } ] } },
    { "id": "link-path", "input": "[[folder/Beta]]", "expect": { "links": [ { "span": [0, 15], "embed": false, "path": "folder/Beta", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-md-extension", "input": "[[Beta.md]]", "expect": { "links": [ { "span": [0, 11], "embed": false, "path": "Beta.md", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-current-file-heading", "input": "[[#设计]]", "expect": { "links": [ { "span": [0, 7], "embed": false, "path": "", "headingPath": ["设计"], "alias": null, "blockRef": false } ] } },
    { "id": "link-trim", "input": "[[ Beta ]]", "expect": { "links": [ { "span": [0, 10], "embed": false, "path": "Beta", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-heading-trim", "input": "[[Gamma# 设计 ]]", "expect": { "links": [ { "span": [0, 14], "embed": false, "path": "Gamma", "headingPath": ["设计"], "alias": null, "blockRef": false } ] } },
    { "id": "link-unicode", "input": "[[中文笔记]]", "expect": { "links": [ { "span": [0, 8], "embed": false, "path": "中文笔记", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-block-ref", "input": "[[Gamma#^abc123]]", "expect": { "links": [ { "span": [0, 17], "embed": false, "path": "Gamma", "headingPath": ["^abc123"], "alias": null, "blockRef": true } ] } },
    { "id": "embed-attachment", "input": "![[photo.png]]", "expect": { "links": [ { "span": [0, 14], "embed": true, "path": "photo.png", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "embed-note", "input": "![[Beta]]", "expect": { "links": [ { "span": [0, 9], "embed": true, "path": "Beta", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "embed-note-heading", "input": "![[Beta#概览]]", "expect": { "links": [ { "span": [0, 12], "embed": true, "path": "Beta", "headingPath": ["概览"], "alias": null, "blockRef": false } ] } },
    { "id": "embed-attachment-alias", "input": "![[photo.png|300]]", "expect": { "links": [ { "span": [0, 18], "embed": true, "path": "photo.png", "headingPath": [], "alias": "300", "blockRef": false } ] } },
    { "id": "none-empty", "input": "[[]]", "expect": { "links": [] } },
    { "id": "none-blank", "input": "[[   ]]", "expect": { "links": [] } },
    { "id": "none-inline-code", "input": "前缀 `[[Beta]]` 后缀", "expect": { "links": [] } },
    { "id": "none-fenced", "input": "```\n[[Beta]]\n```", "expect": { "links": [] } },
    { "id": "none-frontmatter", "input": "---\ntitle: [[Beta]]\n---\n\n正文 [[Gamma]]\n", "expect": { "links": [ { "span": [28, 37], "embed": false, "path": "Gamma", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "none-md-link", "input": "[Beta](Beta.md)", "expect": { "links": [] } },
    { "id": "none-md-image", "input": "![alt](photo.png)", "expect": { "links": [] } },
    { "id": "none-nested-bracket", "input": "[[a [b]]", "expect": { "links": [] } },
    { "id": "multi-in-line", "input": "见 [[Beta]] 与 [[Gamma]]。", "expect": { "links": [ { "span": [2, 10], "embed": false, "path": "Beta", "headingPath": [], "alias": null, "blockRef": false }, { "span": [13, 22], "embed": false, "path": "Gamma", "headingPath": [], "alias": null, "blockRef": false } ] } },
    { "id": "link-heading-hash-boundary", "input": "[[Gamma#C# 入门]]", "expect": { "links": [ { "span": [0, 15], "embed": false, "path": "Gamma", "headingPath": ["C", "入门"], "alias": null, "blockRef": false } ] } }
  ],
  "resolveCases": [
    { "id": "r01-short-path-ambiguous", "from": "Alpha.md", "link": "[[Beta]]", "pendingDecision": "G", "expect": { "status": "ambiguous", "path": "Beta.md", "candidates": ["Beta.md", "folder/Beta.md"], "anchor": { "status": "none" } } },
    { "id": "r02-path-exact", "from": "Alpha.md", "link": "[[folder/Beta]]", "expect": { "status": "resolved", "path": "folder/Beta.md", "anchor": { "status": "none" } } },
    { "id": "r03-short-path-unique", "from": "Alpha.md", "link": "[[Gamma]]", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "none" } } },
    { "id": "r04-case-insensitive", "from": "Alpha.md", "link": "[[case note]]", "expect": { "status": "resolved", "path": "Case Note.md", "anchor": { "status": "none" } } },
    { "id": "r05-case-insensitive-upper", "from": "Alpha.md", "link": "[[CASE NOTE]]", "expect": { "status": "resolved", "path": "Case Note.md", "anchor": { "status": "none" } } },
    { "id": "r06-unicode", "from": "Alpha.md", "link": "[[中文笔记]]", "expect": { "status": "resolved", "path": "中文笔记.md", "anchor": { "status": "none" } } },
    { "id": "r07-unresolved", "from": "Alpha.md", "link": "[[不存在的笔记]]", "expect": { "status": "unresolved" } },
    { "id": "r08-heading-found", "from": "Alpha.md", "link": "[[Gamma#设计]]", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "found", "heading": "设计" } } },
    { "id": "r09-heading-nested-found", "from": "Alpha.md", "link": "[[Gamma#设计#子点]]", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "found", "heading": "子点" } } },
    { "id": "r10-heading-nested-wrong-subtree", "from": "Alpha.md", "link": "[[Gamma#实现#子点]]", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "missing" } } },
    { "id": "r11-heading-missing", "from": "Alpha.md", "link": "[[Gamma#不存在的标题]]", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "missing" } } },
    { "id": "r12-heading-case", "from": "Alpha.md", "link": "[[Gamma#overview]]", "pendingDecision": "H", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "missing" } } },
    { "id": "r13-subdir-unique", "from": "Alpha.md", "link": "[[Deep Note]]", "expect": { "status": "resolved", "path": "sub/Deep Note.md", "anchor": { "status": "none" } } },
    { "id": "r14-current-file-heading", "from": "folder/Gamma.md", "link": "[[#设计]]", "expect": { "status": "resolved", "path": "folder/Gamma.md", "anchor": { "status": "found", "heading": "设计" } } },
    { "id": "r15-block-ref-unsupported", "from": "Alpha.md", "link": "[[Gamma#^abc123]]", "expect": { "status": "unsupported" } },
    { "id": "r16-embed-attachment", "from": "Alpha.md", "link": "![[photo.png]]", "expect": { "status": "resolved", "path": "assets/photo.png", "embedTarget": "attachment", "anchor": { "status": "none" } } },
    { "id": "r17-embed-note-ambiguous", "from": "Alpha.md", "link": "![[Beta]]", "pendingDecision": "G", "expect": { "status": "ambiguous", "path": "Beta.md", "candidates": ["Beta.md", "folder/Beta.md"], "embedTarget": "note", "anchor": { "status": "none" } } },
    { "id": "r18-embed-note-heading", "from": "Alpha.md", "link": "![[Beta#概览]]", "pendingDecision": "G", "expect": { "status": "ambiguous", "path": "Beta.md", "candidates": ["Beta.md", "folder/Beta.md"], "embedTarget": "note", "anchor": { "status": "found", "heading": "概览" } } },
    { "id": "r19-embed-unresolved", "from": "Alpha.md", "link": "![[missing.png]]", "expect": { "status": "unresolved" } },
    { "id": "r20-explicit-extension-ambiguous", "from": "Alpha.md", "link": "[[Beta.md]]", "pendingDecision": "G", "expect": { "status": "ambiguous", "path": "Beta.md", "candidates": ["Beta.md", "folder/Beta.md"], "anchor": { "status": "none" } } },
    { "id": "r21-path-subdir", "from": "Alpha.md", "link": "[[sub/Deep Note]]", "expect": { "status": "resolved", "path": "sub/Deep Note.md", "anchor": { "status": "none" } } },
    { "id": "r22-dotdot-unsupported", "from": "folder/Gamma.md", "link": "[[../Beta]]", "expect": { "status": "unresolved" } },
    { "id": "r23-embed-from-subdir", "from": "folder/Gamma.md", "link": "![[diagram.png]]", "expect": { "status": "resolved", "path": "assets/diagram.png", "embedTarget": "attachment", "anchor": { "status": "none" } } }
  ]
}
